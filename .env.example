PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/arthub
JWT_SECRET=change-me
CLIENT_URL=http://localhost:3000
STRIPE_SECRET_KEY=sk_test_xxx
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
ADMIN_EMAIL=admin@arthub.com
ADMIN_PASSWORD=Admin@123

# --- AI (Google Gemini). Get a key at https://aistudio.google.com/apikey ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-2
AI_DUP_THRESHOLD=0.92

# AI (Google Gemini). Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-2
# Similarity (0-1) above which a new upload is flagged for admin review
DUP_THRESHOLD=0.93
